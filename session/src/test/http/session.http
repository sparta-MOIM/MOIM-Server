### 환경 변수 설정
@baseUrl = http://localhost:8089
@userId = d5a2c91b-6c8a-4f1c-9e2e-4a3f5f2e8c76
@username = 테스트유저
@role = ADMIN

### 세션 생성 - 성공
POST {{baseUrl}}/api/v1/session
Content-Type: application/json
X-User-Name: {{username}}
X-User-Role: {{role}}
X-User-ID: {{userId}}

{
  "organizationId": "org123",
  "publisher": "{{username}}",
  "title": "스파르타 세션",
  "count": 15,
  "status": "READY",
  "openTime": "2024-03-20T10:00:00",
  "closeTime": "2024-03-20T12:00:00",
   "applyInfo": {

  }
}

### 세션 조회 - 성공
GET {{baseUrl}}/api/v1/session/da0b7791-53b0-45c5-aa87-49a8ab222f97
Content-Type: application/json
X-User-Name: {{username}}
X-User-Role: {{role}}
X-User-ID: {{userId}}


### 세션 수정 - 성공
PUT {{baseUrl}}/api/v1/session/b2ae29d4-ad9f-4f24-929a-11f6cf880dbc
Content-Type: application/json

{
  "title": "변경된 타이틀",
  "count": 20
}
### 세션 상태 수정 - 성공
PATCH {{baseUrl}}/api/v1/session/12f4c20e-7fe6-44e2-9793-9e49c3c3f267/state
Content-Type: application/json
X-User-Name: {{username}}
X-User-Role: {{role}}
X-User-ID: {{userId}}

{
  "status": "CLOSED"
}
